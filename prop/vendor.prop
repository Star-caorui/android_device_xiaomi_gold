# ConsumerIR
ro.hardware.consumerir=common

# Crypto
ro.crypto.volume.filenames_mode=aes-256-cts
ro.vendor.mtk_f2fs_enable=1

# DRM
ro.netflix.bsp_rev=MTK6833-32817-1
drm.service.enabled=true

# Fingerprint
persist.vendor.fingerprint.type=side
persist.vendor.fingerprint.sensor_location=1080|1065|180|local:0

# FM
persist.vendor.connsys.fm_chipid=mt6631_6635

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# Gatekeeper
ro.hardware.gatekeeper=mitee

# GNSS
ro.vendor.gps.chrdev=gps_drv_stp

# Graphics
