# Audio
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
audio.deep_buffer.media=true
audio.offload.video=true
audio.offload.min.duration.secs=30
ro.audio.spatializer_enabled=true
ro.audio.usb.period_us=16000
ro.vendor.soundtrigger.dfs.support=1
ro.config.media_vol_default=25
ro.config.vc_call_vol_steps=11
vendor.audio.spkcal.copy.inhal=true
vendor.audiohal.telephonytx.type=2

# Dolby
ro.vendor.audio.device.dbcom=dolby_common
ro.vendor.audio.dolby.dax.support=true
ro.vendor.audio.dolby.dax3_3point8=true
