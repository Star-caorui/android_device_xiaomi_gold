# Enable blur
ro.sf.blurs_are_expensive=1
ro.surface_flinger.supports_background_blur=1

# Bluetooth
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.sap.server.enabled=true

# Identify as stock OS3.0.5.0.VNQMIXM: its build id, and the build ids and fingerprints stock's vendor,
# odm, vendor_dlkm, odm_dlkm and system_dlkm give; the unit's own fingerprint and odm's come with its
# SKU below. system, system_ext and product keep this build's: the package manager tells an update by
# their fingerprints.
ro.build.id=AP3A.240905.015.A2
ro.vendor.build.id=AP3A.240905.015.A2
ro.odm.build.id=AP3A.240905.015.A2
ro.vendor_dlkm.build.id=AP3A.240905.015.A2
ro.odm_dlkm.build.id=AP3A.240905.015.A2
ro.system_dlkm.build.id=AP3A.240905.015.A2
ro.vendor.build.fingerprint=Redmi/vnd_gold/gold:15/AP3A.240905.015.A2/OS3.0.5.0.VNQMIXM:user/release-keys
ro.vendor_dlkm.build.fingerprint=Redmi/vnd_gold/gold:15/AP3A.240905.015.A2/OS3.0.5.0.VNQMIXM:user/release-keys
ro.odm_dlkm.build.fingerprint=Redmi/vnd_gold/gold:15/AP3A.240905.015.A2/OS3.0.5.0.VNQMIXM:user/release-keys
ro.system_dlkm.build.fingerprint=Redmi/vnd_gold/gold:15/AP3A.240905.015.A2/OS3.0.5.0.VNQMIXM:user/release-keys

# Device specific properties
import /product/etc/sku/${ro.boot.product.hardware.sku}.prop

# FM radio: MT6631 (chip id 0x6631), 87.5-108 MHz in 100 kHz steps
ro.fm.chip=26161
ro.fm.band=1
ro.fm.low_band=875
ro.fm.high_band=1080
ro.fm.seek_space=1

# IMS: AOSP carries no VoLTE, video call or Wi-Fi calling availability for the mainland
# carriers, so say they are available and leave the decision to the network.
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
