<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds.  Do not translate.

     NOTE: The naming convention is "config_camelCaseValue". Some legacy
     entries do not follow the convention, but all new entries should. -->

<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Only what differs from or is missing in hardware/mediatek's MssiWifiOverlay, which
         this overlay sits above. -->

    <!-- 1 to 11 only: devices sold where 12 and 13 are not allowed cannot see a hotspot
         that channel selection put there. MssiWifiOverlay allows 1 to 13. -->
    <string translatable="false" name="config_wifiSoftap2gChannelList">1-11</string>

    <!-- Do not disconnect Wi-Fi to apply a country code: try while connected instead.
         The attempt fails either way on this device, because wpa_supplicant is built
         without MediaTek's driver command library. -->
    <bool translatable="false" name="config_wifiStaDynamicCountryCodeUpdateSupported">true</bool>

    <!-- As stock: network centric QoS policies, and link layer statistics summed over all
         radios. -->
    <bool translatable="false" name="config_wifiNetworkCentricQosPolicyFeatureEnabled">true</bool>
    <bool translatable="false" name="config_wifiLinkLayerAllRadiosStatsAggregationEnabled">true</bool>
</resources>
