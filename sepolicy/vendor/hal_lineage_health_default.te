type hal_lineage_health_default, domain;
type hal_lineage_health_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_lineage_health_default)

# Charging control writes the battery's input_suspend node.
allow hal_lineage_health_default sysfs_batteryinfo:dir r_dir_perms;
allow hal_lineage_health_default sysfs_batteryinfo:file rw_file_perms;
allow hal_lineage_health_default sysfs_batteryinfo:lnk_file r_file_perms;

# Register IChargingControl/IFastCharge with servicemanager
binder_use(hal_lineage_health_default)
add_service(hal_lineage_health_default, hal_lineage_health_service)
