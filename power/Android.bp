cc_library_static {
    name: "libperfmgr-ext.gold",
    defaults: ["android.hardware.power-ndk_shared"],
    vendor: true,
    srcs: ["PowerModeExtension.cpp"],
    shared_libs: ["libbase"],
}

cc_library_shared {
    name: "vendor.mediatek.hardware.power@2.0",
    vendor: true,
    compile_multilib: "first",
    srcs: ["MtkPowerV2Stub.cpp"],
    shared_libs: ["libutils"],
}
